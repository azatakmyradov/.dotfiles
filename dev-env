#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dry=0
cleanup=0

usage() {
	cat <<EOF
Usage: $(basename "$0") [--dry] [--cleanup]

Sync dotfile directories/files into your home directory.
  --dry      Print actions without running them
  --cleanup  Remove managed entries instead of copying them
EOF
}

while (($#)); do
	case "$1" in
		--dry) dry=1 ;;
		--cleanup) cleanup=1 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
	esac
	shift
done

log() {
	if ((dry)); then
		printf '[DRY_RUN]: %s\n' "$*"
	else
		printf '%s\n' "$*"
	fi
}

run() {
	log "execute $*"
	((dry)) || "$@"
}

sync_entries() {
	local from=$1 to=$2 type=$3 entry dest

	[[ -d "$from" ]] || return 0
	((cleanup)) || run mkdir -p "$to"

	while IFS= read -r -d '' entry; do
		dest="$to/$(basename "$entry")"
		run rm -rf "$dest"
		((cleanup)) || run cp -R "$entry" "$dest"
	done < <(find "$script_dir/$from" -mindepth 1 -maxdepth 1 -type "$type" -print0)
}

sync_tree() {
	local from=$1 to=$2
	sync_entries "$from" "$to" d
	sync_entries "$from" "$to" f
}

log '------------------ dev --------------------'

sync_tree config "$HOME/.config"
sync_tree local "$HOME/.local"
sync_tree home "$HOME"

if [[ "$(uname -s)" == "Linux" ]]; then
	sync_tree linux_config "$HOME/.config"
fi
