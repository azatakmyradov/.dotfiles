#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
STOW_DIR="$DOTFILES_DIR/stow"
DRY_RUN=0
BACKUP_ROOT=""
PI_SETUP_CLONE_PLANNED=0
PI_SETUP_DIR="$HOME/personal/pi-setup"
PI_SETUP_REPOSITORY='https://github.com/azatakmyradov/pi-setup.git'
PI_SETUP_LEGACY_SOURCE='git:github.com/azatakmyradov/pi-setup.git'

usage() {
    cat <<'EOF'
Usage: dotfiles <command> [target] [--dry-run]

Commands:
  install [target]  Install dependencies and link configuration (default: workstation)
  update [target]   Update the repository, dependencies, and configuration
  link <target>     Link configuration with GNU Stow
  unlink <target>   Unlink configuration with GNU Stow
  doctor [target]   Check dependencies and deployed configuration

Targets:
  core, herdr, tmux, opencode, desktop, pi, dev, workstation, all
  ghostty and linux may also be linked directly.

Examples:
  dotfiles install core
  dotfiles install herdr
  dotfiles install opencode
  dotfiles install pi
  dotfiles install workstation
  dotfiles update workstation
  dotfiles update pi --dry-run
  dotfiles link herdr
  dotfiles unlink herdr
  dotfiles doctor herdr
  dotfiles install --dry-run
EOF
}

log_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

run() {
    log_command "$@"
    ((DRY_RUN)) || "$@"
}

fail() {
    printf 'dotfiles: %s\n' "$*" >&2
    exit 1
}

contains_word() {
    local wanted=$1 word
    shift
    for word in "$@"; do
        [[ "$word" == "$wanted" ]] && return 0
    done
    return 1
}

features_for() {
    case "$1" in
        core) printf '%s\n' core ;;
        herdr) printf '%s\n' herdr ;;
        tmux) printf '%s\n' tmux ;;
        opencode) printf '%s\n' opencode ;;
        desktop)
            printf '%s\n' ghostty
            [[ "$(uname -s)" == Linux ]] && printf '%s\n' linux
            ;;
        pi|dev) ;;
        workstation)
            printf '%s\n' core herdr opencode ghostty
            [[ "$(uname -s)" == Linux ]] && printf '%s\n' linux
            ;;
        all)
            printf '%s\n' core herdr tmux opencode ghostty
            [[ "$(uname -s)" == Linux ]] && printf '%s\n' linux
            ;;
        ghostty) printf '%s\n' "$1" ;;
        linux)
            [[ "$(uname -s)" == Linux ]] || fail 'the linux target is only available on Linux'
            printf '%s\n' linux
            ;;
        *) fail "unknown target: $1" ;;
    esac
}

feature_list() {
    local feature
    case "$1" in
        core|herdr|tmux|opencode|desktop|pi|dev|workstation|all|ghostty|linux) ;;
        *) fail "unknown target: $1" ;;
    esac
    if [[ "$1" == linux && "$(uname -s)" != Linux ]]; then
        fail 'the linux target is only available on Linux'
    fi
    FEATURES=()
    while IFS= read -r feature; do
        [[ -n "$feature" ]] && FEATURES+=("$feature")
    done < <(features_for "$1")
}

add_unique() {
    local value=$1 existing
    for existing in "${PACKAGES[@]:-}"; do
        [[ "$existing" == "$value" ]] && return
    done
    PACKAGES+=("$value")
}

target_includes_pi() {
    case "$1" in
        pi|dev|all) return 0 ;;
        *) return 1 ;;
    esac
}

ensure_brew() {
    local installer
    if command -v brew >/dev/null 2>&1; then
        return
    fi
    if ((DRY_RUN)); then
        printf '+ curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o <temporary-file>\n'
        printf '+ /bin/bash <temporary-file>\n'
        return
    fi

    installer=$(mktemp "${TMPDIR:-/tmp}/homebrew-install.XXXXXX")
    log_command curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$installer"
    if ! curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$installer"; then
        rm -f "$installer"
        fail 'could not download the Homebrew installer'
    fi
    log_command /bin/bash "$installer"
    if ! /bin/bash "$installer"; then
        rm -f "$installer"
        fail 'the Homebrew installer failed'
    fi
    rm -f "$installer"

    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    else
        fail 'Homebrew installation did not put brew on PATH'
    fi
}

ensure_paru() {
    if command -v paru >/dev/null 2>&1; then
        return
    fi
    run sudo pacman -S --needed base-devel git
    run rm -rf /tmp/paru-package
    run git clone https://aur.archlinux.org/paru.git /tmp/paru-package
    if ((DRY_RUN)); then
        printf '+ (cd /tmp/paru-package && makepkg -si --needed)\n'
    else
        (cd /tmp/paru-package && makepkg -si --needed)
    fi
}

find_herdr_binary() {
    if [[ ${HERDR_BIN_PATH:-} && -x "$HERDR_BIN_PATH" ]]; then
        printf '%s\n' "$HERDR_BIN_PATH"
        return
    fi
    if command -v herdr >/dev/null 2>&1; then
        command -v herdr
        return
    fi
    if [[ -x "$HOME/.local/bin/herdr" ]]; then
        printf '%s\n' "$HOME/.local/bin/herdr"
        return
    fi
    return 1
}

install_herdr_linux() {
    local installer
    if ((DRY_RUN)); then
        printf '+ curl -fsSL https://herdr.dev/install.sh -o <temporary-file>\n'
        printf '+ sh <temporary-file>\n'
        return
    fi

    installer=$(mktemp "${TMPDIR:-/tmp}/herdr-install.XXXXXX")
    log_command curl -fsSL https://herdr.dev/install.sh -o "$installer"
    if ! curl -fsSL https://herdr.dev/install.sh -o "$installer"; then
        rm -f "$installer"
        fail 'could not download the Herdr installer'
    fi
    log_command /bin/sh "$installer"
    if ! /bin/sh "$installer"; then
        rm -f "$installer"
        fail 'the Herdr installer failed'
    fi
    rm -f "$installer"
    find_herdr_binary >/dev/null 2>&1 || fail 'Herdr installation completed but no executable was found'
}

find_pi_binary() {
    local npm_prefix
    if command -v pi >/dev/null 2>&1; then
        command -v pi
        return
    fi
    if [[ -x "$HOME/.local/bin/pi" ]]; then
        printf '%s\n' "$HOME/.local/bin/pi"
        return
    fi
    if command -v npm >/dev/null 2>&1; then
        npm_prefix=$(npm prefix -g 2>/dev/null || npm config get prefix 2>/dev/null || true)
        if [[ -n "$npm_prefix" && -x "$npm_prefix/bin/pi" ]]; then
            printf '%s\n' "$npm_prefix/bin/pi"
            return
        fi
    fi
    return 1
}

install_pi_cli() {
    local installer
    find_pi_binary >/dev/null 2>&1 && return
    if ((DRY_RUN)); then
        printf '+ curl -fsSL https://pi.dev/install.sh -o <temporary-file>\n'
        printf '+ sh <temporary-file>\n'
        return
    fi

    installer=$(mktemp "${TMPDIR:-/tmp}/pi-install.XXXXXX")
    log_command curl -fsSL https://pi.dev/install.sh -o "$installer"
    if ! curl -fsSL https://pi.dev/install.sh -o "$installer"; then
        rm -f "$installer"
        fail 'could not download the Pi installer'
    fi
    log_command /bin/sh "$installer"
    if ! /bin/sh "$installer"; then
        rm -f "$installer"
        fail 'the Pi installer failed'
    fi
    rm -f "$installer"
    find_pi_binary >/dev/null 2>&1 || fail 'Pi installation completed but no executable was found'
}

ensure_pi_setup_checkout() {
    ((PI_SETUP_CLONE_PLANNED)) && return 0
    command -v git >/dev/null 2>&1 || fail 'git is required to clone pi-setup'
    if [[ -e "$PI_SETUP_DIR" || -L "$PI_SETUP_DIR" ]]; then
        [[ -d "$PI_SETUP_DIR" ]] || fail "$PI_SETUP_DIR exists and is not a directory"
        git -C "$PI_SETUP_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "$PI_SETUP_DIR is not a Git worktree"
        return
    fi

    run mkdir -p "$(dirname -- "$PI_SETUP_DIR")"
    run git clone "$PI_SETUP_REPOSITORY" "$PI_SETUP_DIR"
    if ((DRY_RUN)); then
        PI_SETUP_CLONE_PLANNED=1
    fi
}

install_pi_setup() {
    local pi_bin package_list
    ensure_pi_setup_checkout

    if ! pi_bin=$(find_pi_binary); then
        if ((DRY_RUN)); then
            log_command pi install "$PI_SETUP_DIR"
            return
        fi
        fail 'Pi is required to install pi-setup'
    fi

    package_list=$("$pi_bin" list 2>/dev/null || true)
    if grep -Fq "$PI_SETUP_LEGACY_SOURCE" <<<"$package_list"; then
        run "$pi_bin" remove "$PI_SETUP_LEGACY_SOURCE"
    fi
    grep -Fq "$PI_SETUP_DIR" <<<"$package_list" && return
    run "$pi_bin" install "$PI_SETUP_DIR"
}

install_dependencies() {
    local target=$1 feature os
    feature_list "$target"
    os=$(uname -s)
    PACKAGES=()

    case "$os" in
        Darwin)
            ensure_brew
            for feature in ${FEATURES[@]+"${FEATURES[@]}"}; do
                case "$feature" in
                    core) add_unique stow; add_unique fish; add_unique starship ;;
                    herdr) add_unique stow; add_unique fish; add_unique fd; add_unique fzf; add_unique jq; add_unique herdr ;;
                    tmux) add_unique stow; add_unique tmux ;;
                    opencode|ghostty|linux) add_unique stow ;;
                esac
            done
            if [[ "$target" == dev || "$target" == all ]]; then
                add_unique neovim
            fi
            if target_includes_pi "$target"; then
                add_unique node
            fi
            ((${#PACKAGES[@]} == 0)) || run brew install "${PACKAGES[@]}"
            if contains_word ghostty ${FEATURES[@]+"${FEATURES[@]}"}; then
                run brew install --cask ghostty helium-browser
            fi
            ;;
        Linux)
            command -v pacman >/dev/null 2>&1 || fail 'Linux installation currently supports Arch Linux (pacman)'
            for feature in ${FEATURES[@]+"${FEATURES[@]}"}; do
                case "$feature" in
                    core) add_unique stow; add_unique fish; add_unique starship ;;
                    herdr) add_unique stow; add_unique fish; add_unique fd; add_unique fzf; add_unique jq; add_unique curl ;;
                    tmux) add_unique stow; add_unique tmux ;;
                    opencode|ghostty|linux) add_unique stow ;;
                esac
            done
            if [[ "$target" == dev || "$target" == all ]]; then
                add_unique neovim
            fi
            if target_includes_pi "$target"; then
                add_unique curl
                add_unique nodejs
                add_unique npm
            fi
            ((${#PACKAGES[@]} == 0)) || run sudo pacman -S --needed "${PACKAGES[@]}"

            if contains_word herdr ${FEATURES[@]+"${FEATURES[@]}"} && ! find_herdr_binary >/dev/null 2>&1; then
                install_herdr_linux
            fi
            if contains_word ghostty ${FEATURES[@]+"${FEATURES[@]}"}; then
                ensure_paru
                run paru -S --needed ghostty helium-browser-bin
            fi
            ;;
        *) fail "unsupported operating system: $os" ;;
    esac

    if target_includes_pi "$target"; then
        install_pi_cli
        install_pi_setup
    fi
}

validate_update_repository() {
    local status
    command -v git >/dev/null 2>&1 || fail 'git is required to update dotfiles'
    git -C "$DOTFILES_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "$DOTFILES_DIR is not a Git worktree"
    git -C "$DOTFILES_DIR" symbolic-ref --quiet HEAD >/dev/null 2>&1 || fail 'cannot update from a detached HEAD'
    git -C "$DOTFILES_DIR" rev-parse --verify '@{upstream}' >/dev/null 2>&1 || fail 'the current branch has no upstream'
    status=$(git -C "$DOTFILES_DIR" status --porcelain=v1 --untracked-files=normal)
    [[ -z "$status" ]] || fail 'the dotfiles worktree has local changes; commit or remove them before updating'
}

update_repository() {
    local target=$1 revision
    if [[ -n ${DOTFILES_UPDATE_POST_PULL:-} ]]; then
        revision=$DOTFILES_UPDATE_POST_PULL
        unset DOTFILES_UPDATE_POST_PULL
        validate_update_repository
        [[ "$(git -C "$DOTFILES_DIR" rev-parse HEAD)" == "$revision" ]] || fail 'the repository changed while restarting the update'
        return
    fi

    validate_update_repository
    if ((DRY_RUN)); then
        run git -C "$DOTFILES_DIR" pull --ff-only
        return
    fi

    run git -C "$DOTFILES_DIR" pull --ff-only
    revision=$(git -C "$DOTFILES_DIR" rev-parse HEAD)
    log_command env DOTFILES_UPDATE_POST_PULL="$revision" "$DOTFILES_DIR/bin/dotfiles" update "$target"
    exec env DOTFILES_UPDATE_POST_PULL="$revision" "$DOTFILES_DIR/bin/dotfiles" update "$target"
}

validate_pi_setup_checkout() {
    local status
    command -v git >/dev/null 2>&1 || fail 'git is required to update pi-setup'
    [[ -d "$PI_SETUP_DIR" ]] || fail "$PI_SETUP_DIR does not exist"
    git -C "$PI_SETUP_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "$PI_SETUP_DIR is not a Git worktree"
    git -C "$PI_SETUP_DIR" symbolic-ref --quiet HEAD >/dev/null 2>&1 || fail 'cannot update pi-setup from a detached HEAD'
    git -C "$PI_SETUP_DIR" rev-parse --verify '@{upstream}' >/dev/null 2>&1 || fail 'the pi-setup branch has no upstream'
    status=$(git -C "$PI_SETUP_DIR" status --porcelain=v1 --untracked-files=normal)
    [[ -z "$status" ]] || fail 'the pi-setup worktree has local changes; commit or remove them before updating'
}

preflight_pi_setup_update() {
    [[ -e "$PI_SETUP_DIR" || -L "$PI_SETUP_DIR" ]] || return 0
    validate_pi_setup_checkout
}

update_pi_setup_checkout() {
    if ((DRY_RUN)) && [[ ! -d "$PI_SETUP_DIR" ]]; then
        return
    fi
    validate_pi_setup_checkout
    run git -C "$PI_SETUP_DIR" pull --ff-only
}

update_pi() {
    local pi_bin
    if ! pi_bin=$(find_pi_binary); then
        if ((DRY_RUN)); then
            log_command pi update --all
            return
        fi
        fail 'Pi is required to update Pi packages'
    fi
    run "$pi_bin" update --all
}

update_dependencies() {
    local target=$1 os herdr_bin
    os=$(uname -s)
    feature_list "$target"

    case "$os" in
        Darwin)
            ensure_brew
            run brew update
            install_dependencies "$target"
            ((${#PACKAGES[@]} == 0)) || run brew upgrade "${PACKAGES[@]}"
            if contains_word ghostty ${FEATURES[@]+"${FEATURES[@]}"}; then
                run brew upgrade --cask --greedy ghostty helium-browser
            fi
            ;;
        Linux)
            command -v pacman >/dev/null 2>&1 || fail 'Linux updates currently support Arch Linux (pacman)'
            run sudo pacman -Syu
            install_dependencies "$target"
            if contains_word herdr ${FEATURES[@]+"${FEATURES[@]}"}; then
                if herdr_bin=$(find_herdr_binary); then
                    run "$herdr_bin" update
                elif ((DRY_RUN)); then
                    log_command herdr update
                else
                    fail 'Herdr is required to update the herdr target'
                fi
            fi
            if contains_word ghostty ${FEATURES[@]+"${FEATURES[@]}"}; then
                run paru -Syu --needed ghostty helium-browser-bin
            fi
            ;;
        *) fail "unsupported operating system: $os" ;;
    esac

    if target_includes_pi "$target"; then
        update_pi
    fi
}

update_target() {
    local target=$1

    # Validate targets and local checkouts before changing the machine.
    feature_list "$target"
    if target_includes_pi "$target"; then
        preflight_pi_setup_update
    fi
    update_repository "$target"
    if target_includes_pi "$target"; then
        ensure_pi_setup_checkout
        update_pi_setup_checkout
    fi
    update_dependencies "$target"
    link_target "$target"
    if ((DRY_RUN)); then
        log_command "$DOTFILES_DIR/bin/dotfiles" doctor "$target"
    else
        doctor_target "$target"
    fi
}

ensure_stow() {
    ((DRY_RUN)) || command -v stow >/dev/null 2>&1 || fail 'GNU Stow is required; run `dotfiles install <target>` first'
}

assert_safe_destination() {
    local rel=$1 remainder=$1 component ancestor=$HOME
    while [[ "$remainder" == */* ]]; do
        component=${remainder%%/*}
        remainder=${remainder#*/}
        ancestor="$ancestor/$component"
        if [[ -L "$ancestor" ]]; then
            fail "refusing to modify files through symlinked directory: $ancestor"
        fi
    done
}

validate_package_destinations() {
    local package=$1 source rel
    while IFS= read -r -d '' source; do
        rel=${source#"$STOW_DIR/$package/"}
        assert_safe_destination "$rel"
    done < <(find "$STOW_DIR/$package" \( -type f -o -type l \) ! -name .gitignore -print0)
}

ensure_backup_root() {
    if [[ -z "$BACKUP_ROOT" ]]; then
        BACKUP_ROOT="$HOME/.dotfiles-backups/$(date +%Y%m%d-%H%M%S)-$$"
    fi
}

backup_path() {
    local path=$1 rel=$2
    [[ -e "$path" || -L "$path" ]] || return 0
    assert_safe_destination "$rel"
    ensure_backup_root
    run mkdir -p "$BACKUP_ROOT/$(dirname -- "$rel")"
    run mv "$path" "$BACKUP_ROOT/$rel"
}

backup_conflicts() {
    local package=$1 source rel destination
    while IFS= read -r -d '' source; do
        rel=${source#"$STOW_DIR/$package/"}
        destination="$HOME/$rel"
        if [[ -e "$destination" && "$source" -ef "$destination" ]]; then
            continue
        fi
        backup_path "$destination" "$rel"
    done < <(find "$STOW_DIR/$package" \( -type f -o -type l \) ! -name .gitignore -print0)
}

backup_legacy_tmux_sessionizer() {
    backup_path "$HOME/.local/scripts/tmux-sessionizer" '.local/scripts/tmux-sessionizer'
}

link_target() {
    local target=$1 package
    feature_list "$target"
    ((${#FEATURES[@]} == 0)) && return
    ensure_stow

    # Validate every package before changing the home directory.
    for package in ${FEATURES[@]+"${FEATURES[@]}"}; do
        [[ -d "$STOW_DIR/$package" ]] || fail "missing Stow package: $package"
        validate_package_destinations "$package"
    done
    if contains_word herdr ${FEATURES[@]+"${FEATURES[@]}"} && { [[ -e "$HOME/.local/scripts/tmux-sessionizer" ]] || [[ -L "$HOME/.local/scripts/tmux-sessionizer" ]]; }; then
        assert_safe_destination '.local/scripts/tmux-sessionizer'
    fi

    # Back up all conflicts before the first Stow deployment.
    for package in ${FEATURES[@]+"${FEATURES[@]}"}; do
        backup_conflicts "$package"
    done
    if contains_word herdr ${FEATURES[@]+"${FEATURES[@]}"}; then
        backup_legacy_tmux_sessionizer
    fi

    for package in ${FEATURES[@]+"${FEATURES[@]}"}; do
        run stow --no-folding --restow --dir "$STOW_DIR" --target "$HOME" "$package"
    done
    if [[ -n "$BACKUP_ROOT" ]]; then
        if ((DRY_RUN)); then
            printf 'Would back up conflicting files to %s\n' "$BACKUP_ROOT"
        else
            printf 'Backed up conflicting files to %s\n' "$BACKUP_ROOT"
        fi
    fi
}

unlink_target() {
    local target=$1 package
    feature_list "$target"
    ((${#FEATURES[@]} == 0)) && return
    ensure_stow
    for package in ${FEATURES[@]+"${FEATURES[@]}"}; do
        [[ -d "$STOW_DIR/$package" ]] || fail "missing Stow package: $package"
        validate_package_destinations "$package"
    done
    for package in ${FEATURES[@]+"${FEATURES[@]}"}; do
        run stow --no-folding --delete --dir "$STOW_DIR" --target "$HOME" "$package"
    done
}

check_ok() {
    printf 'ok   %s\n' "$1"
}

check_fail() {
    printf 'FAIL %s\n' "$1" >&2
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
}

check_command() {
    if command -v "$1" >/dev/null 2>&1; then
        check_ok "$1 is installed"
    else
        check_fail "$1 is not installed"
    fi
}

check_deployed_package() {
    local package=$1 source rel destination missing=0
    while IFS= read -r -d '' source; do
        rel=${source#"$STOW_DIR/$package/"}
        destination="$HOME/$rel"
        if [[ ! -e "$destination" || ! "$source" -ef "$destination" ]]; then
            missing=1
            break
        fi
    done < <(find "$STOW_DIR/$package" \( -type f -o -type l \) ! -name .gitignore -print0)

    if ((missing)); then
        check_fail "$package configuration is not fully deployed"
    else
        check_ok "$package configuration is deployed"
    fi
}

check_herdr() {
    local roots_value root found=0
    local config_source="$STOW_DIR/herdr/.config/herdr/config.toml"
    local sessionizer_source="$STOW_DIR/herdr/.local/bin/herdr-sessionizer"

    if [[ ${HERDR_BIN_PATH+x} ]]; then
        if [[ -n "$HERDR_BIN_PATH" && -x "$HERDR_BIN_PATH" ]]; then
            check_ok 'HERDR_BIN_PATH points to an executable'
        else
            check_fail 'HERDR_BIN_PATH does not point to an executable'
        fi
    else
        check_command herdr
    fi
    check_command fish
    check_command fd
    check_command fzf
    check_command jq

    if [[ -e "$HOME/.config/herdr/config.toml" && "$config_source" -ef "$HOME/.config/herdr/config.toml" ]]; then
        check_ok 'Herdr config is deployed by Stow'
    else
        check_fail 'Herdr config is not deployed by Stow'
    fi
    if [[ -x "$HOME/.local/bin/herdr-sessionizer" && "$sessionizer_source" -ef "$HOME/.local/bin/herdr-sessionizer" ]]; then
        check_ok 'herdr-sessionizer is deployed and executable'
    else
        check_fail 'herdr-sessionizer is not deployed by Stow or executable'
    fi

    if [[ ${HERDR_PROJECT_ROOTS+x} ]]; then
        roots_value=$HERDR_PROJECT_ROOTS
    else
        roots_value="$HOME/personal:$HOME/work:$HOME/rebelscan:$HOME/notes:$HOME/sagex3"
    fi
    while IFS= read -r root; do
        case "$root" in
            '~') root=$HOME ;;
            '~/'*) root="$HOME/${root#\~/}" ;;
        esac
        if [[ -n "$root" && -d "$root" ]]; then
            found=1
            break
        fi
    done < <(printf '%s\n' "$roots_value" | tr ':' '\n')
    if ((found)); then
        check_ok 'at least one Herdr project root exists'
    else
        check_fail 'none of the configured Herdr project roots exist'
    fi
}

check_pi() {
    local pi_bin package_list
    if pi_bin=$(find_pi_binary); then
        check_ok 'pi is installed'
    else
        check_fail 'pi is not installed'
        pi_bin=""
    fi

    if command -v node >/dev/null 2>&1; then
        if node -e 'const [major, minor, patch] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && (minor > 19 || (minor === 19 && patch >= 0))) ? 0 : 1)' >/dev/null 2>&1; then
            check_ok 'Node.js 22.19.0 or newer is installed'
        else
            check_fail 'Node.js 22.19.0 or newer is required'
        fi
    else
        check_fail 'node is not installed'
    fi
    check_command npm

    if git -C "$PI_SETUP_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        check_ok 'pi-setup local checkout exists'
    else
        check_fail 'pi-setup local checkout is missing or invalid'
    fi

    if [[ -n "$pi_bin" ]]; then
        package_list=$("$pi_bin" list 2>/dev/null || true)
        if grep -Fq "$PI_SETUP_DIR" <<<"$package_list"; then
            check_ok 'pi-setup is installed from the local checkout'
        else
            check_fail 'pi-setup is not installed from the local checkout'
        fi
    else
        check_fail 'pi-setup registration could not be checked'
    fi
}

check_helium() {
    if [[ "$(uname -s)" == Darwin ]]; then
        if [[ -d /Applications/Helium.app || -d "$HOME/Applications/Helium.app" ]]; then
            check_ok 'Helium is installed'
        else
            check_fail 'Helium is not installed'
        fi
    elif command -v helium >/dev/null 2>&1 || command -v helium-browser >/dev/null 2>&1; then
        check_ok 'Helium is installed'
    else
        check_fail 'Helium is not installed'
    fi
}

doctor_target() {
    local target=$1 feature
    DOCTOR_FAILURES=0
    feature_list "$target"

    if target_includes_pi "$target"; then
        check_pi
    fi

    for feature in ${FEATURES[@]+"${FEATURES[@]}"}; do
        if [[ "$feature" == herdr ]]; then
            check_herdr
            continue
        fi
        check_deployed_package "$feature"
        case "$feature" in
            core) check_command fish; check_command starship ;;
            tmux) check_command tmux ;;
            ghostty) check_command ghostty ;;
        esac
    done
    if [[ "$target" == dev || "$target" == all ]]; then
        check_command nvim
    fi
    if [[ "$target" == desktop || "$target" == workstation || "$target" == all ]]; then
        check_helium
    fi

    if ((DOCTOR_FAILURES)); then
        printf '\n%d check(s) failed.\n' "$DOCTOR_FAILURES" >&2
        return 1
    fi
    printf '\nAll checks passed.\n'
}

COMMAND=${1:-help}
[[ $# -eq 0 ]] || shift
TARGET=""
while (($#)); do
    case "$1" in
        --dry-run|--dry) DRY_RUN=1 ;;
        -h|--help) COMMAND=help ;;
        -*) fail "unknown option: $1" ;;
        *)
            [[ -z "$TARGET" ]] || fail 'only one target may be specified'
            TARGET=$1
            ;;
    esac
    shift
done

case "$COMMAND" in
    install)
        TARGET=${TARGET:-workstation}
        install_dependencies "$TARGET"
        link_target "$TARGET"
        ;;
    update)
        TARGET=${TARGET:-workstation}
        update_target "$TARGET"
        ;;
    link)
        TARGET=${TARGET:-workstation}
        link_target "$TARGET"
        ;;
    unlink)
        TARGET=${TARGET:-workstation}
        unlink_target "$TARGET"
        ;;
    doctor)
        TARGET=${TARGET:-workstation}
        doctor_target "$TARGET"
        ;;
    help|-h|--help) usage ;;
    *) usage >&2; fail "unknown command: $COMMAND" ;;
esac
