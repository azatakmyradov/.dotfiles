{
	"$schema": "https://opencode.ai/config.json",
	"plugins": [
		"/Users/azatakmyradov/personal/opencode-plugins/packages/mcp-toggle",
		"@azatakmyradov/opencode-recap-plugin",
		{
			"package": "@azatakmyradov/opencode-git-plugin",
			"options": {
				"model": "openai/gpt-5.6-luna"
			}
		}
	],
	"agents": {
		"plan": {
			"disabled": true
		}
	},
	"mcp": {
		"servers": {
			"x3": {
				"type": "local",
				"command": [
					"x3",
					"mcp",
					"--enable-dangerous-ops"
				]
			}
		}
	}
}
