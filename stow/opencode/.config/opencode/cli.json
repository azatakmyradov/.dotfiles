{
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "plugins": [
    "./plugins/setup/tui.ts"
  ],
  "keybinds": {
    "session.compact": "none"
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "image_preview": false,
    "grouping": "auto"
  },
  "tabs": {
    "layout": "vertical",
    "scope": "cwd",
    "enabled": true
  },
  "debug": {
    "turn_tokens": false
  },
  "diffs": {
    "view": "unified"
  },
  "scroll": {
    "acceleration": false
  }
}
