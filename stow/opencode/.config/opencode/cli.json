{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "model.list": "ctrl+l",
    "variant.cycle": "shift+tab",
    "agent.cycle": "none",
    "prompt.queue": "shift+return",
    "input.newline": "ctrl+return,ctrl+j"
  },
  "tabs": {
    "enabled": false
  },
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "thinking": "hide"
  }
}
