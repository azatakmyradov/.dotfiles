#!/usr/bin/env bash
set -uo pipefail

# Usage: rex-sessionizer         pick a project on any Rex host and switch to it
#        rex-sessionizer --list  print this machine's project directories

fail() {
    printf 'rex-sessionizer: %s\n' "$*" >&2
    if [[ -t 0 ]]; then
        read -r -p 'Press Enter to close...'
    fi
    exit 1
}

if [[ -n "${REX_PROJECT_ROOTS:-}" ]]; then
    IFS=: read -r -a search_roots <<<"$REX_PROJECT_ROOTS"
else
    search_roots=("$HOME/personal" "$HOME/work" "$HOME/rebelscan" "$HOME/notes" "$HOME/sagex3" "$HOME/x3/*")
fi

command -v fd >/dev/null 2>&1 || fail 'missing dependency: fd'

resolve() {
    (cd -- "$1" 2>/dev/null && pwd -P)
}

list_projects() {
    local root match project
    local roots=()
    for root in "${search_roots[@]}"; do
        case "$root" in
            '~') root=$HOME ;;
            '~/'*) root="$HOME/${root#\~/}" ;;
        esac

        if [[ "$root" == *'/*' ]]; then
            for match in "${root%/\*}"/*; do
                [[ -d "$match" ]] && roots+=("$(resolve "$match")")
            done
        elif [[ -n "$root" && -d "$root" ]]; then
            roots+=("$(resolve "$root")")
        fi
    done

    ((${#roots[@]} > 0)) || return 0

    fd --type d --hidden --exclude .git --absolute-path --max-depth 1 --min-depth 1 . "${roots[@]}" \
        | while IFS= read -r project; do resolve "$project"; done \
        | sort -u
}

if [[ "${1:-}" == --list ]]; then
    list_projects
    exit
fi

for cmd in fzf jq; do
    command -v "$cmd" >/dev/null 2>&1 || fail "missing dependency: $cmd"
done

rex_bin=rex
if [[ -n "${REX_BIN_PATH:-}" && -x "$REX_BIN_PATH" ]]; then
    rex_bin=$REX_BIN_PATH
else
    command -v rex >/dev/null 2>&1 || fail 'missing dependency: rex'
fi

# "local" is the server this picker runs on; other hosts come from `rex hosts`.
rex_at() {
    local host=$1
    shift
    if [[ "$host" == local ]]; then
        "$rex_bin" "$@"
    else
        "$rex_bin" -S "$host" --timeout 5s "$@"
    fi
}

hosts=(local)
while IFS= read -r host; do
    [[ -n "$host" && "$host" != local ]] && hosts+=("$host")
done < <("$rex_bin" hosts --json 2>/dev/null | jq -r '.hosts[]?.host.label // empty')

# Sessions are matched by label, so a label must identify one project on its
# host: the folder name, or parent/name when two projects share a folder name.
declare -A name_count=() session_ids=()
entries=()
for host in "${hosts[@]}"; do
    if [[ "$host" == local ]]; then
        projects=$(list_projects)
        sessions=$("$rex_bin" ls --json 2>/dev/null) || fail 'could not list Rex sessions'
    else
        # Unreachable hosts, or ones without the sessionizer_projects action, are skipped.
        projects=$(rex_at "$host" do sessionizer_projects 2>/dev/null | jq -r '.projects[]? // empty') || continue
        sessions=$(rex_at "$host" ls --json 2>/dev/null) || continue
    fi

    while IFS= read -r project; do
        [[ -n "$project" ]] || continue
        entries+=("$host"$'\t'"$project")
        name=${project##*/}
        name_count[$host$'\t'$name]=$((${name_count[$host$'\t'$name]:-0} + 1))
    done <<<"$projects"

    while IFS=$'\t' read -r label session_id; do
        [[ -n "$label" && -z "${session_ids[$host$'\t'$label]:-}" ]] && session_ids[$host$'\t'$label]=$session_id
    done < <(printf '%s\n' "$sessions" | jq -r '.sessions[]? | select(.label != null) | [.label, .session_id] | @tsv')
done

((${#entries[@]} > 0)) || fail 'no project directories found'

label_for() {
    local host=$1 project=$2 name=${2##*/} parent
    parent=${project%/*}
    parent=${parent##*/}
    if ((${name_count[$host$'\t'$name]} > 1)); then
        printf '%s/%s' "$parent" "$name"
    else
        printf '%s' "$name"
    fi
}

# Tag rows with their host only when another host contributed projects.
show_host=0
for entry in "${entries[@]}"; do
    [[ "${entry%%$'\t'*}" != local ]] && show_host=1 && break
done

rows=()
for entry in "${entries[@]}"; do
    host=${entry%%$'\t'*}
    project=${entry#*$'\t'}
    label=$(label_for "$host" "$project")
    session_id=${session_ids[$host$'\t'$label]:--}
    marker=' '
    [[ "$session_id" != - ]] && marker='●'
    parent=${project%/*}
    display="$marker ${project##*/} — ${parent##*/}"
    ((show_host)) && display+="  [$host]"
    rows+=("$display"$'\t'"$host"$'\t'"$project"$'\t'"$session_id")
done

selection=$(printf '%s\n' "${rows[@]}" | fzf \
    --delimiter=$'\t' \
    --with-nth=1 \
    --prompt='Project> ' \
    --layout=reverse \
    --border=rounded \
    --no-multi)

[[ -n "$selection" ]] || exit 0

IFS=$'\t' read -r _ host project session_id <<<"$selection"
[[ -n "$host" && -n "$project" && -n "$session_id" ]] || fail 'invalid picker selection'

if [[ "$session_id" == - ]]; then
    created=$(rex_at "$host" new "$(label_for "$host" "$project")" -c "$project" --json) \
        || fail "could not create session: $project"
    session_id=$(printf '%s\n' "$created" | jq -er '.session_id') \
        || fail "could not read the new session: $project"
fi

# The launching action passes its client so the switch happens in that app.
# The app connects to each host as a separate client with the same label.
client_args=()
if [[ -n "${REX_CLIENT:-}" ]]; then
    if [[ "$host" == local ]]; then
        client_args=(-C "$REX_CLIENT")
    else
        app_label=$("$rex_bin" client ls --json 2>/dev/null \
            | jq -r --arg id "$REX_CLIENT" '.clients[]? | select(.client_id == $id) | .info.label // empty')
        client_id=$(rex_at "$host" client ls --json 2>/dev/null \
            | jq -r --arg label "$app_label" \
                'first(.clients[]? | select(.info.kind == "app" and .info.label == $label) | .client_id) // empty')
        [[ -n "$client_id" ]] || fail "Rex.app is not connected to $host"
        client_args=(-C "$client_id")
    fi
fi

rex_at "$host" ${client_args[@]+"${client_args[@]}"} do session.select session_id="$session_id" >/dev/null \
    || fail "could not switch to session: $project (is Remote Control on in Rex Settings > Rex Server?)"
